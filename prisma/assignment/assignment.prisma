model assignment {
        uuid            String          @id @default(uuid(7)) @db.Uuid
        title           String
        description     String
        icon            String
        assignment_type assignment_type

        tech_slug String?
        tech      tech?   @relation(fields: [tech_slug], references: [slug])

        tests assignment_test[]

        submissions submission[]
        version     Int          @default(1)
        paths       path[]
}

model assignment_test {
        uuid               String     @id @default(uuid(7)) @db.Uuid
        assignment_uuid    String     @db.Uuid
        related_assignment assignment @relation(fields: [assignment_uuid], references: [uuid])
        name               String
        code               String
}

enum assignment_type {
        //@@type("pg/text@1")
        learning
        exercise
        problem
}
